<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Seni çok özledim ❤️</title>
<style>
:root{--bg1:#ffe3ea;--bg2:#fff4e8;--card:rgba(255,255,255,.72);--text:#4a1f2e;--muted:#8a5566;--accent:#d6336c;--bar:#f3b6c8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg1:#2a1220;--bg2:#1b0f1a;--card:rgba(40,20,34,.72);--text:#ffe9f0;--muted:#d9a5b8;--accent:#ff6b9a;--bar:#5a2a41}}
:root[data-theme="dark"]{--bg1:#2a1220;--bg2:#1b0f1a;--card:rgba(40,20,34,.72);--text:#ffe9f0;--muted:#d9a5b8;--accent:#ff6b9a;--bar:#5a2a41}
html,body{margin:0;min-height:100%}
body{font-family:Georgia,"Times New Roman",serif;color:var(--text);background:linear-gradient(160deg,var(--bg1),var(--bg2));background-attachment:fixed;display:flex;align-items:center;justify-content:center;overflow-x:hidden}
#slides{position:fixed;inset:0;z-index:0}
#slides div{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 2s;filter:blur(3px) brightness(.8)}
#slides div.on{opacity:.55}
.hearts{position:fixed;inset:0;pointer-events:none;z-index:1;overflow:hidden}
.hearts span{position:absolute;bottom:-40px;animation:up linear infinite;opacity:.6}
@keyframes up{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}
main{position:relative;z-index:2;width:100%;max-width:560px;padding:24px 16px;text-align:center}
.card{background:var(--card);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:28px;padding:28px 18px;box-shadow:0 10px 40px rgba(0,0,0,.15)}
.hero{width:100%;max-height:52vh;object-fit:cover;border-radius:20px;margin-bottom:16px;box-shadow:0 8px 28px rgba(0,0,0,.25)}
h1{margin:0 0 6px;font-size:clamp(26px,7vw,38px);color:var(--accent);font-weight:normal}
p.sub{margin:0 0 22px;color:var(--muted);font-size:16px;line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.box{background:var(--card);border-radius:18px;padding:14px 4px;border:1px solid var(--bar)}
.num{font-size:clamp(28px,9vw,44px);font-weight:bold;color:var(--accent);font-variant-numeric:tabular-nums}
.lab{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
.bar{height:10px;background:var(--bar);border-radius:6px;margin:24px 0 6px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);border-radius:6px;transition:width 1s}
.small{font-size:13px;color:var(--muted)}
button{margin-top:18px;background:var(--accent);color:#fff;border:0;border-radius:24px;padding:11px 22px;font:inherit;font-size:15px;cursor:pointer}
#done{display:none;font-size:clamp(28px,8vw,42px);color:var(--accent);line-height:1.3}
</style>
</head>
<body>
<div id="slides"></div>
<div class="hearts" id="hearts"></div>
<main>
<div class="card">
<img id="hero" class="hero" alt="" style="display:none"><h1>Seni çok özledim her şeyim, sağ salim dön bana ❤️</h1>
<p class="sub" id="sub">Dualarınla birlikte dön bana; İstanbul’a, evine, kalbime…<br>Gelmene kalan süre:</p>
<div class="grid" id="grid">
<div class="box"><div class="num" id="d">0</div><div class="lab">Gün</div></div>
<div class="box"><div class="num" id="h">0</div><div class="lab">Saat</div></div>
<div class="box"><div class="num" id="m">0</div><div class="lab">Dakika</div></div>
<div class="box"><div class="num" id="s">0</div><div class="lab">Saniye</div></div>
</div>
<div id="done">Hoş geldin aşkım! 🎉❤️<br>Seni çok özledim.</div>
<div class="bar"><i id="fill"></i></div>
<div class="small" id="pct">20 Ekim’de gittin, 4 Kasım’da döneceksin</div>
<button id="mbtn" style="display:none">🎵 Şarkımızı çal</button>
<audio id="aud" loop></audio>
</div>
</main>
<script>
// ====== AYARLAR ======
var START = new Date("2026-10-20T00:00:00+03:00");
var END   = new Date("2026-11-04T00:00:00+03:00"); // İstanbul saati; iniş saatine göre değiştirilebilir
var PHOTOS = ["data:image/jpeg;base64,"];
var SONG = "data:audio/mpeg;base64,";
// =====================
var $=function(i){return document.getElementById(i)};
function tick(){
  var now=new Date(),diff=END-now;
  if(diff<=0){$("grid").style.display="none";$("sub").style.display="none";$("done").style.display="block";$("fill").style.width="100%";$("pct").textContent="Artık yanımdasın ❤️";return}
  var t=Math.floor(diff/1000);
  $("d").textContent=Math.floor(t/86400);
  $("h").textContent=String(Math.floor(t%86400/3600)).padStart(2,"0");
  $("m").textContent=String(Math.floor(t%3600/60)).padStart(2,"0");
  $("s").textContent=String(t%60).padStart(2,"0");
  var p=Math.max(0,Math.min(100,(now-START)/(END-START)*100));
  $("fill").style.width=p.toFixed(1)+"%";
  $("pct").textContent="Yolculuğun %"+Math.floor(p)+" tamamlandı • 4 Kasım’da döneceksin";
}
tick();setInterval(tick,1000);
// kalpler
var H=$("hearts"),em=["❤️","💗","💕","💖"];
for(var i=0;i<14;i++){var e=document.createElement("span");e.textContent=em[i%4];e.style.left=Math.random()*100+"%";e.style.fontSize=(14+Math.random()*18)+"px";e.style.animationDuration=(8+Math.random()*10)+"s";e.style.animationDelay=(-Math.random()*12)+"s";H.appendChild(e)}
// fotoğraf slayt
if(PHOTOS.length){
  $("hero").src=PHOTOS[0];$("hero").style.display="block";
  var S=$("slides"),els=PHOTOS.map(function(u){var d=document.createElement("div");d.style.backgroundImage="url("+u+")";S.appendChild(d);return d}),c=0;
  els[0].className="on";
  if(els.length>1)setInterval(function(){els[c].className="";c=(c+1)%els.length;els[c].className="on"},5000);
}
// şarkı
if(SONG){
  var a=$("aud"),b=$("mbtn");a.src=SONG;b.style.display="inline-block";
  b.onclick=function(){if(a.paused){a.play();b.textContent="⏸ Müziği durdur"}else{a.pause();b.textContent="🎵 Şarkımızı çal"}};
}
</script>
</body>
</html>
